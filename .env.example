# Copy to .env. The defaults run fully locally and need no keys:
#   - LLM:        Llama 3.2 3B via Ollama   (ollama pull llama3.2:3b)
#   - Classifier: rule-based                (switch to the fine-tuned Qwen below)

# --- LLM provider -----------------------------------------------------------
# AUDIT_LLM_PROVIDER=ollama               # ollama | anthropic
# AUDIT_OLLAMA_MODEL=llama3.2:3b

# Only needed with AUDIT_LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# AUDIT_ANTHROPIC_MODEL=claude-sonnet-5

# --- Transaction classifier -------------------------------------------------
# qlora loads the adapter produced by `python -m finetuning.train_qlora`
# from data/models/qwen_risk_classifier/adapter (CUDA GPU required).
# AUDIT_CLASSIFIER=rule_based             # rule_based | qlora
# AUDIT_QLORA_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

# --- Retrieval and engagement (defaults shown) ------------------------------
# AUDIT_EMBEDDING_MODEL=all-MiniLM-L6-v2
# AUDIT_CHUNK_SIZE=800
# AUDIT_CHUNK_OVERLAP=120
# AUDIT_TOP_K=4
# AUDIT_CLIENT_NAME=Northwind Retail Group Inc.
# AUDIT_DATA_DIR=data
